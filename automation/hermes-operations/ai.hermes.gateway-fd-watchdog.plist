<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.gateway-fd-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/insideden/.hermes/scripts/gateway_fd_watchdog.py</string>
    <string>--threshold</string>
    <string>180</string>
    <string>--cooldown</string>
    <string>300</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_HOME</key>
    <string>/Users/insideden/.hermes</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/insideden/.hermes/logs/gateway-fd-watchdog.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/insideden/.hermes/logs/gateway-fd-watchdog.stderr.log</string>
</dict>
</plist>
